# Copy to .env (git-ignored) and fill in. Nothing here has a working default on purpose.

# Password for the MySQL root user used by docker-compose and the backend.
DB_PASSWORD=choose-a-password

# Secret that signs login tokens. At least 32 characters; generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins allowed to call the API (the Vue dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:3000
